{
  "version": "0.1.0",
  "patterns": [
    {
      "id": "desu",
      "pattern": "です",
      "level": "N5",
      "category": "copula",
      "meaning": "to be (polite)",
      "explanation": "Polite copula used to state what something is or to describe something.",
      "formation": "Noun/Na-adjective + です",
      "matching": {
        "substring": "です",
        "regex": "です"
      }
    },
    {
      "id": "da",
      "pattern": "だ",
      "level": "N5",
      "category": "copula",
      "meaning": "to be (casual)",
      "explanation": "Casual copula used to state what something is. Less formal than です.",
      "formation": "Noun/Na-adjective + だ",
      "matching": {
        "substring": "だ",
        "regex": "[^ん]だ(?![っと])"
      }
    },
    {
      "id": "masu",
      "pattern": "ます",
      "level": "N5",
      "category": "verb-form",
      "meaning": "polite verb ending",
